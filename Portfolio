<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Denis Tyazhlov  — Freelance Websites Rotterdam</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0b0d0c;
    --surface:#151816;
    --surface-2:#1c211d;
    --line:rgba(255,255,255,0.09);
    --text:#f4f5f2;
    --text-dim:#9aa39c;
    --accent:#d4ff4f;
    --accent-dim:rgba(212,255,79,0.14);
    --radius:14px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg); color:var(--text);
    font-family:'Inter', sans-serif; line-height:1.6;
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  a{color:inherit; text-decoration:none;}
  button{font-family:inherit; background:none; border:none; color:inherit; cursor:pointer;}
  .wrap{max-width:1120px; margin:0 auto; padding:0 28px;}
  h1,h2,h3{font-family:'Archivo', sans-serif; font-weight:800; line-height:1.02; letter-spacing:-0.01em;}
  a:focus-visible, button:focus-visible{outline:2px solid var(--accent); outline-offset:3px;}
  section{scroll-margin-top:96px;}

  /* Progressive-enhancement reveal: hidden only once JS confirms it can animate them back in */
  html.js .reveal{opacity:0; transform:translateY(22px); transition:opacity .6s ease, transform .6s ease;}
  html.js .reveal.visible{opacity:1; transform:translateY(0);}

  /* ===== GRID BACKDROP ===== */
  .grid-bg{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:44px 44px;
    -webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 100%);
            mask-image:radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 100%);
  }

  /* ===== LOADER ===== */
  .loader{
    position:fixed; inset:0; z-index:999; background:var(--bg);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px;
    animation:autohide 2.6s ease forwards; cursor:pointer;
  }
  .loader.dismiss{opacity:0 !important; visibility:hidden !important; pointer-events:none !important; transition:opacity .4s ease;}
  @keyframes autohide{0%,78%{opacity:1; visibility:visible;} 100%{opacity:0; visibility:hidden; pointer-events:none;}}
  @media(prefers-reduced-motion:reduce){ .loader{animation:none; opacity:0; visibility:hidden; pointer-events:none;} }
  .loader-icons{display:flex; gap:14px;}
  .licon{width:44px; height:44px; border-radius:50%; border:1px solid var(--line); display:flex; align-items:center; justify-content:center; color:var(--text-dim);}
  .licon svg{width:19px; height:19px;}
  .loader-title{font-size:clamp(1.6rem,5vw,2.4rem); text-align:center; line-height:1.1;}
  .loader-chip{font-family:monospace; font-size:0.8rem; color:var(--text-dim); border:1px solid var(--line); padding:7px 16px; border-radius:999px;}

  /* ===== NAV ===== */
  .nav-stage{position:sticky; top:16px; z-index:50; display:flex; justify-content:center; padding:0 20px;}
  .capsule-nav{
    display:flex; align-items:center; gap:28px; background:rgba(21,24,22,0.75);
    backdrop-filter:blur(10px); border:1px solid var(--line);
    border-radius:999px; padding:10px 10px 10px 20px; max-width:100%;
  }
  .nav-logo{font-family:'Archivo', sans-serif; font-weight:800; font-size:0.92rem;}
  .nav-logo span{color:var(--text-dim); font-weight:500;}
  .nav-links{display:flex; align-items:center; gap:4px;}
  .nav-links a{font-size:0.84rem; color:var(--text-dim); padding:8px 14px; border-radius:999px; transition:color .15s, background .15s;}
  .nav-links a:hover{color:var(--text);}
  .nav-links a.active{color:var(--bg); background:var(--accent); font-weight:600;}
  @media(max-width:560px){ .capsule-nav{gap:12px; padding:8px 8px 8px 16px;} .nav-links{gap:0;} .nav-links a{padding:7px 9px; font-size:0.76rem;} }

  /* ===== HERO ===== */
  .hero{position:relative; padding:90px 0 70px; z-index:1;}
  .hero-grid{display:grid; grid-template-columns:1fr; gap:56px; align-items:center;}
  @media(min-width:860px){ .hero-grid{grid-template-columns:1.3fr 0.7fr;} }
  .eyebrow{display:inline-flex; align-items:center; gap:8px; font-size:0.8rem; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:22px;}
  .eyebrow .dot{width:7px; height:7px; border-radius:50%; background:var(--accent);}
  @media(prefers-reduced-motion:no-preference){ .eyebrow .dot{animation:blink 2s ease-in-out infinite;} }
  @keyframes blink{0%,100%{opacity:1;}50%{opacity:.3;}}
  .hero h1{font-size:clamp(2.6rem,7vw,4.6rem); margin-bottom:22px;}
  .hero h1 .accent-text{color:var(--accent);}
  .hero p{font-size:1.05rem; color:var(--text-dim); max-width:46ch; margin-bottom:28px;}
  .tag-row{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:30px;}
  .tag{font-size:0.8rem; border:1px solid var(--line); color:var(--text-dim); padding:8px 16px; border-radius:999px;}
  .hero-hints{display:flex; flex-direction:column; gap:6px; font-size:0.82rem; color:var(--text-dim);}

  .hero-badge-wrap{display:flex; flex-direction:column; align-items:center; position:relative; padding-top:10px;}
  .lanyard{width:2px; height:64px; background:linear-gradient(var(--line), var(--text-dim)); position:relative;}
  .badge-tag{
    position:absolute; top:30px; left:calc(50% + 18px); transform:rotate(90deg); transform-origin:left center;
    font-family:monospace; font-size:0.62rem; letter-spacing:0.15em; color:var(--text-dim); white-space:nowrap;
  }
  .badge-card{
    width:190px; background:var(--surface); border:1px solid var(--line); border-radius:16px;
    padding:26px 20px; text-align:center; transform-origin:top center; box-shadow:0 20px 50px -20px rgba(0,0,0,0.6);
  }
  @media(prefers-reduced-motion:no-preference){ .badge-card{animation:sway 4.5s ease-in-out infinite;} }
  @keyframes sway{0%,100%{transform:rotate(-2.5deg);} 50%{transform:rotate(2.5deg);}}
  .badge-avatar{
    width:64px; height:64px; border-radius:50%; margin:0 auto 14px; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, var(--accent), #7fae2c); color:var(--bg); font-family:'Archivo',sans-serif; font-weight:800; font-size:1.3rem;
  }
  .badge-name{font-weight:600; font-size:0.94rem;}
  .badge-role{font-size:0.76rem; color:var(--text-dim); margin-top:3px;}

  /* ===== ABOUT ===== */
  .about{padding:80px 0; position:relative; z-index:1;}
  .about-grid{display:grid; grid-template-columns:1fr; gap:50px;}
  @media(min-width:900px){ .about-grid{grid-template-columns:1.2fr 0.8fr;} }
  .big-name{font-size:clamp(2.2rem,6vw,3.4rem); margin-bottom:20px;}
  .about p{color:var(--text-dim); max-width:52ch; margin-bottom:22px;}
  blockquote{
    border-left:2px solid var(--accent); padding:4px 0 4px 18px; font-style:italic; color:var(--text);
    margin-bottom:28px; font-size:0.98rem;
  }
  .about-actions{display:flex; gap:14px; flex-wrap:wrap;}
  .btn{display:inline-flex; align-items:center; gap:8px; padding:13px 24px; border-radius:999px; font-size:0.9rem; font-weight:600; transition:transform .15s, background .15s, border-color .15s;}
  .btn-accent{background:var(--accent); color:var(--bg);}
  .btn-accent:hover{transform:translateY(-2px); background:#e2ff77;}
  .btn-outline{border:1px solid var(--line); color:var(--text);}
  .btn-outline:hover{border-color:var(--accent); color:var(--accent);}

  .stat-col{display:flex; flex-direction:column; gap:14px;}
  .stat-item{
    display:flex; align-items:center; gap:16px; background:var(--surface); border:1px solid var(--line);
    border-radius:var(--radius); padding:20px; transition:border-color .2s, transform .2s;
  }
  .stat-item:hover{border-color:var(--accent); transform:translateX(4px);}
  .stat-icon{width:38px; height:38px; border-radius:10px; background:var(--accent-dim); color:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0;}
  .stat-icon svg{width:18px; height:18px;}
  .stat-body{flex:1;}
  .stat-num{font-family:'Archivo',sans-serif; font-weight:800; font-size:1.3rem; display:block;}
  .stat-label{font-size:0.78rem; color:var(--text-dim);}
  .stat-arrow{color:var(--text-dim); font-size:1.1rem;}

  /* ===== PORTFOLIO / TABS ===== */
  .portfolio{padding:80px 0 100px; position:relative; z-index:1;}
  .section-head{margin-bottom:36px; max-width:60ch;}
  .section-head h2{font-size:clamp(1.9rem,4.5vw,2.6rem); margin-bottom:12px;}
  .section-head p{color:var(--text-dim);}

  .tabs{display:inline-flex; gap:6px; background:var(--surface); border:1px solid var(--line); border-radius:999px; padding:6px; margin-bottom:34px; flex-wrap:wrap;}
  .tab{padding:10px 20px; border-radius:999px; font-size:0.86rem; color:var(--text-dim); transition:background .15s, color .15s;}
  .tab.active{background:var(--accent); color:var(--bg); font-weight:600;}

  .tab-panel{margin-top:0;}
  html.js .tab-panel{display:none; opacity:0; transform:translateY(10px); transition:opacity .3s ease, transform .3s ease;}
  html.js .tab-panel.show{display:block; opacity:1; transform:translateY(0);}

  .project-grid{display:grid; grid-template-columns:1fr; gap:22px;}
  @media(min-width:760px){ .project-grid{grid-template-columns:1fr 1fr;} }
  .project-card{background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; transition:transform .2s, border-color .2s;}
  .project-card:hover{transform:translateY(-5px); border-color:var(--accent);}
  .preview-chrome{display:flex; gap:6px; padding:12px 14px; border-bottom:1px solid var(--line);}
  .preview-chrome span{width:8px; height:8px; border-radius:50%; background:var(--line);}
  .preview-fake{aspect-ratio:16/10; display:flex; align-items:center; justify-content:center;}
  .preview-fake-logo{font-family:'Archivo',sans-serif; font-weight:800; font-size:1.5rem; color:#fff;}
  .project-card-body{padding:20px;}
  .project-card-body h3{font-family:'Inter',sans-serif; font-weight:600; font-size:1.02rem; margin-bottom:6px;}
  .project-card-body p{color:var(--text-dim); font-size:0.86rem; margin-bottom:14px;}
  .preview-open{font-size:0.84rem; color:var(--accent); font-weight:600; display:inline-flex; align-items:center; gap:6px;}

  .service-grid{display:grid; grid-template-columns:1fr; gap:16px;}
  @media(min-width:760px){ .service-grid{grid-template-columns:repeat(3,1fr);} }
  .service-card{background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:24px;}
  .service-card h3{font-family:'Inter',sans-serif; font-weight:600; font-size:1rem; margin-bottom:8px;}
  .service-card p{color:var(--text-dim); font-size:0.86rem; margin-bottom:16px;}
  .service-price{font-family:'Archivo',sans-serif; font-weight:800; color:var(--accent);}
  .service-price .was{color:var(--text-dim); text-decoration:line-through; font-weight:500; margin-right:8px; font-family:'Inter',sans-serif;}

  .process-list{display:flex; flex-direction:column; gap:0; max-width:680px;}
  .process-item{display:flex; gap:18px; padding:20px 0; border-bottom:1px solid var(--line);}
  .process-item:first-child{border-top:1px solid var(--line);}
  .process-num{font-family:'Archivo',sans-serif; font-weight:800; color:var(--accent); flex-shrink:0; width:28px;}
  .process-item p{color:var(--text-dim); font-size:0.92rem;}
  .process-item strong{color:var(--text); font-weight:600;}

  /* ===== CONTACT ===== */
  .contact{padding:20px 0 90px; position:relative; z-index:1;}
  .contact-box{background:var(--surface); border:1px solid var(--line); border-radius:24px; padding:56px 40px; text-align:center;}
  .contact-box h2{font-size:clamp(1.8rem,5vw,2.6rem); margin-bottom:16px;}
  .contact-box p{color:var(--text-dim); max-width:48ch; margin:0 auto 30px;}
  .contact-actions{display:flex; gap:14px; justify-content:center; flex-wrap:wrap;}

  footer{padding:28px 0 40px; text-align:center; color:var(--text-dim); font-size:0.8rem; position:relative; z-index:1;}

  /* ===== MODAL ===== */
  .modal{position:fixed; inset:0; background:rgba(5,7,6,0.82); display:flex; align-items:center; justify-content:center; padding:20px; z-index:200; opacity:0; pointer-events:none; transition:opacity .2s ease;}
  .modal.open{opacity:1; pointer-events:auto;}
  .modal-inner{width:100%; max-width:440px; height:82vh; max-height:780px; background:#fff; border-radius:20px; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 50px 120px rgba(0,0,0,0.6);}
  .modal-bar{display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#f4f0e6; border-bottom:1px solid rgba(0,0,0,0.08);}
  .modal-title{font-size:0.9rem; font-weight:600; color:#1a1a1a;}
  .modal-close{width:28px; height:28px; border-radius:50%; background:rgba(0,0,0,0.08); color:#1a1a1a; font-size:1.1rem;}
  .modal-close:hover{background:rgba(0,0,0,0.16);}
  #modalFrame{flex:1; border:none; width:100%;}
</style>
</head>
<body>
<script>document.documentElement.classList.add('js');</script>

<div class="grid-bg" aria-hidden="true"></div>

<div class="loader" id="loader">
  <div class="loader-icons">
    <span class="licon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="8 6 2 12 8 18"/><polyline points="16 6 22 12 16 18"/></svg></span>
    <span class="licon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-3.5 3.5-6 8-6s8 2.5 8 6"/></svg></span>
