        <span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/></svg></span>
        <div class="stat-body"><span class="stat-num">2</span><span class="stat-label">Voorbeeldprojecten</span></div>
        <a href="#werk" class="stat-arrow">→</a>
      </div>
      <div class="stat-item">
        <span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
        <div class="stat-body"><span class="stat-num">&lt; 24u</span><span class="stat-label">Reactietijd</span></div>
        <a href="#contact" class="stat-arrow">→</a>
      </div>
      <div class="stat-item">
        <span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5.5c0-1.5-2-2.5-5-2.5s-5 1.2-5 3 2 2.7 5 3 5 1.5 5 3-2 3-5 3-5-1-5-2.5"/></svg></span>
        <div class="stat-body"><span class="stat-num">€ 100</span><span class="stat-label">Introductieprijs</span></div>
        <a href="#werk" class="stat-arrow">→</a>
      </div>
    </div>
  </div>
</section>

<section class="portfolio reveal" id="werk">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>portfolio</span>
      <h2>Zo ziet dat eruit</h2>
